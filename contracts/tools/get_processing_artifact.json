{
  "name": "get_processing_artifact",
  "title": "Get processing artifact",
  "description": "Read one validated immutable minutes-ensemble artifact using meeting_id, scope, run_id and opaque artifact_id. The requested run must own it or have a recorded public reuse binding; presence elsewhere is insufficient. artifact.run_id is the immutable original owner; requested_run_id/binding.run_id identify current adoption. The top-level reused flag and binding.reused must be identical. binding exposes bounded public dependency mappings, nullable retry lineage and an opaque authorization snapshot ID. A generated artifact keeps the successful retry origin while lineage preserves the first unknown and full confirmed chain, including connection changes. Private snapshots, prompts, credentials, canonical requests, raw provider responses, paths and runtime state are never returned. body_sha256 covers the complete public payload; content_projection_sha256 is the stable downstream projection and differs from request identity. Partial validated drafts are readable before publication. Local read only. On failure return error_envelope (isError=true) with not_found, scope_denied, invalid_argument or internal.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "meeting_id": {
        "$ref": "../defs/common.json#/$defs/meeting_id"
      },
      "scope": {
        "$ref": "../defs/common.json#/$defs/scope"
      },
      "run_id": {
        "$ref": "../defs/processing_runs.json#/$defs/processing_run_id"
      },
      "artifact_id": {
        "$ref": "../defs/processing_runs.json#/$defs/processing_artifact_id"
      }
    },
    "required": [
      "meeting_id",
      "run_id",
      "artifact_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "requested_run_id",
      "artifact",
      "payload",
      "binding",
      "reused"
    ],
    "properties": {
      "requested_run_id": {
        "$ref": "../defs/processing_runs.json#/$defs/processing_run_id"
      },
      "artifact": {
        "$ref": "../defs/processing_artifacts.json#/$defs/processing_artifact_header"
      },
      "payload": {},
      "binding": {
        "$ref": "../defs/processing_artifacts.json#/$defs/processing_artifact_binding"
      },
      "reused": {
        "type": "boolean",
        "description": "Required current-adoption reuse flag. Server validation requires it to equal binding.reused."
      }
    },
    "additionalProperties": false,
    "$ref": "../defs/processing_artifacts.json#/$defs/processing_artifact_response"
  },
