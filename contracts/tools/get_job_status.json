{
  "name": "get_job_status",
  "title": "Get job status",
  "description": "Return the current state of a background job created by stop_recording (process), regenerate/register_context (regenerate), export_minutes (export), or prepare_provider_runtime (provider_setup, no meeting). status is queued/running/succeeded/failed/cancelled. Running progress has stage and fraction. Every job includes required nullable processing_run_id: a durable minutes-ensemble run ID from the point the run is prepared and persisted, including running, blocked, failed and cancelled work, or null before that point and for legacy single processing, export and provider setup. Every succeeded result separately includes required nullable processing_run_id; when both values are non-null they must be identical. A succeeded regenerate whose result.stages contains minutes_ensemble must return a non-null result.processing_run_id; legacy or single-model regenerate may return null. Other existing result fields remain operation-specific. Failed error is structured. Jobs are volatile and not rebuilt from bundles; missing live work never proves durable run completion or permits resend. Provider setup acceptance remains in list_providers runtime state. API transcription unknown errors retain the typed one-chunk ledger shape. Minutes unknown errors use the closed minutes_outcome_unknown shape, separating current target/current_selection from saved origin; a later known failure does not erase an earlier unknown barrier. Read-only. On tool failure return error_envelope (isError=true) with code not_found, invalid_argument or internal.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "job_id": {
        "$ref": "../defs/common.json#/$defs/job_id",
        "description": "Job id returned by stop_recording, regenerate, register_context, export_minutes or prepare_provider_runtime. provider_setup jobs are not associated with a meeting."
      }
    },
    "required": [
      "job_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "job"
    ],
    "properties": {
      "job": {
        "$ref": "../defs/common.json#/$defs/job"
      }
    },
    "additionalProperties": false
  },
