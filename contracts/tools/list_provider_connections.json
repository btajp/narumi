{
  "name": "list_provider_connections",
  "title": "List provider connections",
  "description": "List saved non-secret provider connections, their configuration revisions and independent authentication, model-catalog and generation states. OpenAI-compatible rows disclose the validated endpoint, api_surface and, only for chat_completions, chat_max_tokens_field so the UI can edit the exact saved protocol without reading secrets. Official OpenAI may disclose api_surface=responses. Disabled connections remain visible. No API key, token, digest, Keychain identifier, account history or external provider response is returned. This does not contact providers or read ambient credentials. On failure returns an error_envelope (isError=true) with code: authentication_required, internal. All provider operations require the authenticated resident server; no implicit in-process or unauthenticated HTTP fallback is allowed.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "connections": {
        "type": "array",
        "items": {
          "$ref": "../defs/provider_connections.json#/$defs/provider_connection"
        }
      }
    },
    "required": [
      "connections"
    ],
    "additionalProperties": false
  },
  "examples": {
