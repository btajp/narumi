{
  "name": "list_providers",
  "title": "List providers",
  "description": "List all six supported provider adapters in the canonical UI order: Codex App Server, Claude Agent SDK, OpenAI API, OpenAI-compatible API, Anthropic API and Ollama. Return approved authentication methods and runtime readiness without contacting any provider. Only verified adapter capabilities are available; an installed provider name does not imply a ready connection, verified model or working generation. OpenAI-compatible API advertises api_key and numeric-loopback none authentication; endpoint protocol details are connection-scoped. active_setup and last_setup preserve public job and start request IDs for setup recovery. On failure returns an error_envelope (isError=true) with code: authentication_required, internal. All provider operations require the authenticated resident server; no implicit in-process or unauthenticated HTTP fallback is allowed.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "providers": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "../defs/providers.json#/$defs/provider_descriptor",
            "properties": { "provider_id": { "const": "codex-app-server" } }
          },
          {
            "$ref": "../defs/providers.json#/$defs/provider_descriptor",
            "properties": { "provider_id": { "const": "claude-agent-sdk" } }
          },
          {
            "$ref": "../defs/providers.json#/$defs/provider_descriptor",
            "properties": { "provider_id": { "const": "openai-api" } }
          },
          {
            "$ref": "../defs/providers.json#/$defs/provider_descriptor",
            "properties": { "provider_id": { "const": "openai-compatible-api" } }
          },
          {
            "$ref": "../defs/providers.json#/$defs/provider_descriptor",
            "properties": { "provider_id": { "const": "anthropic-api" } }
          },
          {
            "$ref": "../defs/providers.json#/$defs/provider_descriptor",
            "properties": { "provider_id": { "const": "ollama" } }
          }
        ],
        "items": false,
        "minItems": 6,
        "maxItems": 6,
        "description": "Exactly all six supported adapters in canonical UI order: codex-app-server, claude-agent-sdk, openai-api, openai-compatible-api, anthropic-api, ollama. Readiness is expressed on each descriptor; providers are never omitted because they are not yet prepared."
      }
    },
    "required": [
      "providers"
    ],
    "additionalProperties": false
  },
