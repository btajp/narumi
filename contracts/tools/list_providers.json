{
  "name": "list_providers",
  "title": "List providers",
  "description": "List supported provider adapters, approved authentication methods and runtime readiness without contacting any provider. Only verified adapter capabilities are available; an installed provider name does not imply a ready connection, usable model or working generation. active_setup and last_setup preserve public job and start request IDs for setup recovery. On failure returns an error_envelope (isError=true) with code: authentication_required, internal. All provider operations require the authenticated resident server; no implicit in-process or unauthenticated HTTP fallback is allowed.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "providers": {
        "type": "array",
        "items": {
          "$ref": "../defs/providers.json#/$defs/provider_descriptor"
        }
      }
    },
    "required": [
      "providers"
    ],
    "additionalProperties": false
  },
  "examples": {
