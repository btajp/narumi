{
  "name": "list_processing_runs",
  "title": "List processing runs",
  "description": "List bounded durable minutes-ensemble run summaries for one authorized meeting, ordered by descending created_at with a stable run_id tie-breaker. Default limit is 20, maximum 100. cursor is opaque and URL-safe; reject invalid or mismatched cursors and recheck meeting/scope on every page. Summary counts describe adopted validated work, not provider calls, billing or cost. This version lists only minutes ensembles: do not invent runs for legacy single generation or ASR. Local read only; no generation, retry or external request. On failure return error_envelope (isError=true) with code not_found, scope_denied, invalid_argument or internal.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "meeting_id": {
        "$ref": "../defs/common.json#/$defs/meeting_id"
      },
      "scope": {
        "$ref": "../defs/common.json#/$defs/scope"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "cursor": {
        "$ref": "../defs/processing_runs.json#/$defs/processing_runs_cursor"
      }
    },
    "required": [
      "meeting_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "meeting_id",
      "runs",
      "next_cursor"
    ],
    "properties": {
      "meeting_id": {
        "$ref": "../defs/common.json#/$defs/meeting_id"
      },
      "runs": {
        "type": "array",
        "items": {
          "$ref": "../defs/processing_run_records.json#/$defs/processing_run_summary"
        },
        "maxItems": 100
      },
      "next_cursor": {
        "oneOf": [
          {
            "$ref": "../defs/processing_runs.json#/$defs/processing_runs_cursor"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "examples": {
    "input": [
      {
        "meeting_id": "20260827T030500Z-a1b2c3d4"
      },
      {
        "meeting_id": "20260827T030500Z-a1b2c3d4",
        "scope": "cloudnative",
        "limit": 20,
        "cursor": "opaque_page_2"
      }
    ],
    "output": [
      {
        "meeting_id": "20260827T030500Z-a1b2c3d4",
        "runs": [
          {
            "run_id": "run-33333333333333333333333333333333",
            "kind": "minutes_ensemble",
            "status": "blocked",
            "created_at": "2026-08-29T08:00:00Z",
            "updated_at": "2026-08-29T08:02:00Z",
            "generator_count": 2,
            "completed_generators": 1,
            "attempts_used": 2,
            "attempt_limit": 64,
            "published_version": null,
            "blocked_calls": 1
          }
        ],
        "next_cursor": null
      },
      {
        "meeting_id": "20260827T030500Z-a1b2c3d4",
        "runs": [],
        "next_cursor": null
      }
    ]
  }
}
