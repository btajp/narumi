{
  "name": "get_minutes",
  "title": "Get minutes",
  "description": "Return one immutable minutes version of a meeting as markdown. `version` selects one version (latest by default); `available_versions` is ascending. Regeneration appends and never overwrites. `generated_at` and `provider` describe production; provider=ensemble exactly when the required nullable `provenance` contains the published ensemble selection/artifact snapshot. Legacy, plain and single-provider versions return provenance=null. The publication snapshot is not a fabricated execution origin: inspect its artifacts for original run/call/attempt, effective parameters and confirmed usage. `unresolved_speakers` lists unresolved labels rendered as 話者不明. `scope` follows default-deny meeting lookup. Read-only. On failure returns error_envelope (isError=true) with code: not_found (unknown meeting/version or no minutes), scope_denied, invalid_argument, internal.",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "meeting_id": { "$ref": "../defs/common.json#/$defs/meeting_id" },
      "version": {
        "type": "integer",
        "description": "Minutes version to return (see available_versions / get_meeting.minutes_versions). Defaults to the latest version.",
        "minimum": 1
      },
      "scope": {
        "$ref": "../defs/common.json#/$defs/scope",
        "description": "Omitted = unscoped meetings only. One name = that scope + unscoped. Array of 2+ names = cross-scope lookup (audit-logged)."
      }
    },
    "required": ["meeting_id"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "meeting_id",
      "version",
      "markdown",
      "generated_at",
      "provider",
      "provenance",
      "unresolved_speakers",
      "available_versions"
    ],
    "properties": {
      "meeting_id": { "$ref": "../defs/common.json#/$defs/meeting_id" },
      "version": {
        "type": "integer",
        "description": "The version that was returned.",
        "minimum": 1
      },
      "markdown": {
        "type": "string",
        "description": "Full minutes markdown (minutes/v<N>/minutes.md)."
      },
      "generated_at": {
        "$ref": "../defs/common.json#/$defs/timestamp",
        "description": "UTC time this version was generated."
      },
      "provider": {
        "type": "string",
        "description": "LLM provider registry name used for legacy/single generation, none for plain minutes, or ensemble exactly when provenance is non-null.",
        "minLength": 1
      },
      "provenance": {
        "oneOf": [
          {
            "$ref": "../defs/processing_artifacts.json#/$defs/published_minutes_ensemble_provenance"
          },
          {
            "type": "null"
          }
        ],
        "description": "Required nullable publication provenance. Older and non-ensemble versions use null rather than omitting the field."
      },
      "unresolved_speakers": {
        "type": "array",
        "description": "Speaker labels without a resolved name (shown as 話者不明 in the markdown).",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "available_versions": {
        "type": "array",
        "description": "All generated versions, ascending.",
        "items": { "type": "integer", "minimum": 1 },
        "uniqueItems": true
      }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "const": "ensemble"
            }
          }
        },
        "then": {
          "properties": {
            "provenance": {
              "$ref": "../defs/processing_artifacts.json#/$defs/published_minutes_ensemble_provenance"
            }
          }
        },
        "else": {
          "properties": {
            "provenance": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "examples": {
    "input": [
      {
        "meeting_id": "20260827T030500Z-a1b2c3d4"
      },
      {
        "meeting_id": "20260827T030500Z-a1b2c3d4",
        "version": 1,
        "scope": "cloudnative"
      }
    ],
    "output": [
      {
        "meeting_id": "20260827T030500Z-a1b2c3d4",
        "version": 2,
        "markdown": "# 週次定例\n\n## 決定事項\n- オンボーディング資料を来週までに更新する\n",
        "generated_at": "2026-08-27T04:12:00Z",
        "provider": "none",
        "provenance": null,
        "unresolved_speakers": ["SPEAKER_01"],
        "available_versions": [1, 2]
      },
