{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "recording_display": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "is_main": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "width",
        "height",
        "is_main"
      ],
      "additionalProperties": false
    },
    "recording_playback": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path of a locally generated MP4 with the screen and a single mixed microphone/system audio stream."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    }
  }
}
