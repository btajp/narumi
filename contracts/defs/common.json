{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narumi:defs/common.json",
  "title": "narumi common contract definitions",
  "$defs": {
    "recording_permission": {
      "type": "string",
      "enum": [
        "microphone",
        "screen_recording"
      ],
      "description": "The local macOS permission to configure. No recording is started."
    },
    "recording_permission_action": {
      "type": "string",
      "enum": [
        "request",
        "open_settings"
      ],
      "description": "Request OS permission or open its fixed macOS privacy settings pane. Permission is never granted automatically."
    },
    "recording_permission_report": {
      "type": "object",
      "description": "Read-only recorder permission report. Screen recording denied also covers never requested. Microphone unknown normally means not requested yet.",
      "required": [
        "screen_recording",
        "microphone"
      ],
      "properties": {
        "screen_recording": {
          "type": "string",
          "enum": [
            "granted",
            "denied",
            "unknown"
          ]
        },
        "microphone": {
          "type": "string",
          "enum": [
            "granted",
            "denied",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "gaia_connection": {
      "type": "object",
      "description": "Public Gaia connection settings. Credentials are write-only and are never returned.",
      "required": [
        "url",
        "has_api_key",
        "source"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_api_key": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "saved",
            "environment",
            "unconfigured"
          ]
        }
      },
      "additionalProperties": false
    },
    "meeting_id": {
      "type": "string",
      "description": "Meeting identifier: UTC recording start + 8 hex chars, e.g. 20260827T030500Z-a1b2c3d4",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "request_id": {
      "type": "string",
      "description": "Client-generated idempotency key for write operations (UUID recommended). Repeating a call with the same request_id returns the original result.",
      "minLength": 8,
      "maxLength": 128
    },
    "job_id": {
      "type": "string",
      "description": "Server-issued job identifier for long-running operations.",
      "pattern": "^job-[0-9a-f]{12,32}$"
    },
    "context_id": {
      "type": "string",
      "description": "Identifier of an externally registered context source.",
      "pattern": "^ctx-[0-9a-f]{8,32}$"
    },
    "scope_name": {
      "type": "string",
      "description": "Affiliation (所属元) name that acts as a confidentiality boundary, e.g. cloudnative.",
      "minLength": 1,
      "maxLength": 64
    },
    "scope": {
      "description": "Scope selector. Omitted = only unscoped meetings (default deny). A single name = that scope plus unscoped meetings. An array with 2+ names = explicit cross-scope query (those scopes plus unscoped), which is audit-logged.",
      "oneOf": [
        {
          "$ref": "#/$defs/scope_name"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope_name"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp in UTC (e.g. 2026-08-27T03:05:00Z).",
      "format": "date-time"
    },
    "external_send_policy": {
      "type": "string",
      "description": "What may leave the machine. local_only: nothing. subscription_ok: approved subscription authentication routes allowed. api_ok: metered APIs allowed too. The actual authentication route determines billing; Claude Agent SDK API-key use requires api_ok, and unapproved subscription login is unavailable.",
      "enum": [
        "local_only",
        "subscription_ok",
        "api_ok"
      ]
    },
    "job_status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "job_kind": {
      "type": "string",
      "enum": [
        "process",
        "regenerate",
        "export",
        "provider_setup"
      ]
    },
    "job": {
      "type": "object",
      "required": [
        "job_id",
        "kind",
        "status",
        "processing_run_id",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "meeting_id": {
          "$ref": "#/$defs/meeting_id"
        },
        "kind": {
          "$ref": "#/$defs/job_kind"
        },
        "status": {
          "$ref": "#/$defs/job_status"
        },
        "processing_run_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/processing_run_id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Durable minutes-ensemble run correlated with this job once its run has been prepared and persisted, including running, blocked, failed and cancelled states. Null means no ensemble run is known yet or the job is legacy single-generation, export or provider setup. This field is always present. When both this field and succeeded result.processing_run_id are non-null, server validation requires them to be identical."
        },
        "progress": {
          "type": "object",
          "description": "Free-form progress info (stage name, fraction).",
          "properties": {
            "stage": {
              "type": "string"
            },
            "fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        },
        "result": {
          "type": "object",
          "required": [
            "processing_run_id"
          ],
          "properties": {
            "processing_run_id": {
              "oneOf": [
                {
                  "$ref": "#/$defs/processing_run_id"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Durable minutes-ensemble run produced by this successful job, or null when the successful operation did not run a minutes ensemble. A succeeded regenerate whose result.stages contains minutes_ensemble must return a non-null run ID. The field is never omitted from a success result."
            }
          },
          "additionalProperties": true
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status",
              "kind"
            ],
            "properties": {
              "status": {
                "const": "succeeded"
              },
              "kind": {
                "enum": [
                  "export",
                  "provider_setup"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "properties": {
                  "processing_run_id": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status",
              "kind",
              "result"
            ],
            "properties": {
              "status": {
                "const": "succeeded"
              },
              "kind": {
                "const": "regenerate"
              },
              "result": {
                "required": [
                  "stages"
                ],
                "properties": {
                  "stages": {
                    "type": "array",
                    "contains": {
                      "const": "minutes_ensemble"
                    },
                    "minContains": 1
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "properties": {
                  "processing_run_id": {
                    "$ref": "#/$defs/processing_run_id"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "not_found",
        "scope_denied",
        "contract_mismatch",
        "busy",
        "cancelled",
        "invalid_argument",
        "policy_violation",
        "recorder_unavailable",
        "engine_unavailable",
        "configuration_conflict",
        "authentication_required",
        "model_unavailable",
        "internal"
      ]
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "transcription_outcome_unknown"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/transcription_outcome_unknown_details"
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "const": "minutes_outcome_unknown"
                  }
                }
              },
              "then": {
                "$ref": "#/$defs/minutes_outcome_unknown_details"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "error_envelope": {
      "type": "object",
      "description": "Structured content returned with isError=true.",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "additionalProperties": false
    },
    "meeting_config": {
      "type": "object",
      "properties": {
        "transcription_engine": {
          "type": "string",
          "description": "Registry name: auto | fake | mlx-whisper | faster-whisper"
        },
        "transcription_model": {
          "$ref": "#/$defs/transcription_model"
        },
        "diarization_engine": {
          "type": "string",
          "description": "Registry name: none | fake | pyannote"
        },
        "llm_provider": {
          "type": "string",
          "description": "Registry name: none | fake | claude-agent-sdk | anthropic-api | ollama"
        },
        "minutes_model": {
          "$ref": "#/$defs/minutes_model"
        },
        "minutes_ensemble": {
          "$ref": "#/$defs/minutes_ensemble"
        },
        "external_send_policy": {
          "$ref": "#/$defs/external_send_policy"
        },
        "language": {
          "type": "string",
          "description": "Shared transcription language. API transcription requires auto or a real lowercase two-letter ISO 639-1 code; auto omits the API field. Local engine behavior is unchanged."
        },
        "self_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Display name for the microphone track speaker (me)."
        },
        "vocab_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "minutes_model",
              "minutes_ensemble"
            ],
            "properties": {
              "minutes_model": {
                "$ref": "#/$defs/minutes_model_selection"
              },
              "minutes_ensemble": {
                "$ref": "#/$defs/minutes_ensemble_selection"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "transcription_model"
            ],
            "properties": {
              "transcription_model": {
                "$ref": "#/$defs/transcription_model_selection"
              }
            }
          },
          "then": {
            "properties": {
              "language": {
                "$ref": "#/$defs/api_transcription_language"
              }
            }
          }
        }
      ]
    },
    "track_status": {
      "type": "object",
      "required": [
        "path",
        "discarded"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "discarded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "meeting_summary": {
      "type": "object",
      "required": [
        "meeting_id",
        "meeting_name",
        "status",
        "started_at"
      ],
      "properties": {
        "meeting_id": {
          "$ref": "#/$defs/meeting_id"
        },
        "meeting_name": {
          "type": "string"
        },
        "engagement": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "recording",
            "recorded",
            "processing",
            "ready",
            "failed"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "stopped_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_minutes_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "active_job": {
          "description": "The queued or running job for this meeting, or null / absent when none.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "job_id",
                "kind",
                "status"
              ],
              "properties": {
                "job_id": {
                  "$ref": "#/$defs/job_id"
                },
                "kind": {
                  "$ref": "#/$defs/job_kind"
                },
                "status": {
                  "$ref": "#/$defs/job_status"
                },
                "progress": {
                  "type": "object",
                  "description": "Free-form progress info (stage name, fraction).",
                  "properties": {
                    "stage": {
                      "type": "string"
                    },
                    "fraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "start",
        "end",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ],
          "description": "Speaker label (me / other / SPEAKER_00 …) or resolved name."
        },
        "speaker_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "context_source_type": {
      "type": "string",
      "enum": [
        "notion_ai_minutes",
        "zoom_transcript",
        "meet_transcript",
        "teams_transcript",
        "chat_log",
        "document",
        "text",
        "url",
        "file"
      ]
    },
    "export_destination": {
      "type": "string",
      "description": "Exporter registry name, e.g. markdown | html | notion | gaia-library",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "description": "Saved meeting profile (<NARUMI_HOME>/profiles.json): config defaults, default scope / engagement and automatic export destinations applied to new meetings.",
      "required": [
        "name",
        "config",
        "scope",
        "engagement",
        "export_destinations",
        "is_default"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "config": {
          "$ref": "#/$defs/meeting_config"
        },
        "scope": {
          "description": "Default affiliation scope for meetings created with this profile (null = unscoped).",
          "oneOf": [
            {
              "$ref": "#/$defs/scope_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "engagement": {
          "type": [
            "string",
            "null"
          ],
          "description": "Default engagement label for meetings created with this profile."
        },
        "export_destinations": {
          "type": "array",
          "description": "Exporter registry names run automatically when a meeting using this profile finishes processing.",
          "items": {
            "$ref": "#/$defs/export_destination"
          },
          "uniqueItems": true
        },
        "is_default": {
          "type": "boolean",
          "description": "True for exactly one profile: the one applied when start_recording / import_recording omit `profile`."
        }
      },
      "additionalProperties": false
    }
  }
}
