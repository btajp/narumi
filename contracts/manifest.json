{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "narumi",
  "contract_version": "6.0.0",
  "description": "narumi MCP tool contracts v6. Adds six-provider text minutes generation in canonical UI order, an independently configured OpenAI-compatible API, Claude Agent SDK explicit generation, and one-request model verification for compatible and SDK candidates. OpenAI API transcription remains independently selectable. Ensemble generation, speaker reference audio and implicit request fallback or retry are excluded. Shared types live in defs/*.json.",
  "defs": ["defs/common.json", "defs/providers.json", "defs/provider_connections.json", "defs/provider_models.json", "defs/transcription_models.json"],
  "tools": [
    "get_server_info",
    "configure_recording_permission",
    "start_recording",
    "stop_recording",
    "get_recording_status",
    "import_recording",
    "list_meetings",
    "search_transcripts",
    "get_meeting",
    "get_transcript",
    "get_minutes",
    "register_context",
    "regenerate",
    "set_meeting_config",
    "export_minutes",
    "list_export_destinations",
    "get_job_status",
    "cancel_job",
    "discard_tracks",
    "delete_meeting",
    "list_profiles",
    "get_profile",
    "set_profile",
    "delete_profile",
    "rebuild_catalog",
    "get_gaia_connection",
    "set_gaia_connection",
    "test_gaia_connection",
    "list_providers",
    "list_provider_connections",
    "set_provider_connection",
    "delete_provider_connection",
    "prepare_provider_runtime",
    "authenticate_provider_connection",
    "get_provider_auth_status",
    "test_provider_connection",
    "list_provider_models",
    "verify_provider_model"
  ]
}
