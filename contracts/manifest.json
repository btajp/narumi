{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "narumi",
  "contract_version": "1.1.0",
  "description": "narumi MCP tool contracts v1. Each tool is defined in tools/<name>.json; shared types live in defs/common.json.",
  "defs": ["defs/common.json"],
  "tools": [
    "get_server_info",
    "configure_recording_permission",
    "start_recording",
    "stop_recording",
    "get_recording_status",
    "import_recording",
    "list_meetings",
    "search_transcripts",
    "get_meeting",
    "get_transcript",
    "get_minutes",
    "register_context",
    "regenerate",
    "set_meeting_config",
    "export_minutes",
    "list_export_destinations",
    "get_job_status",
    "cancel_job",
    "discard_tracks",
    "delete_meeting",
    "list_profiles",
    "get_profile",
    "set_profile",
    "delete_profile",
    "rebuild_catalog",
    "get_gaia_connection",
    "set_gaia_connection",
    "test_gaia_connection"
  ]
}
